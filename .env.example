# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash is fast and enough for this demo
GEMINI_MODEL=gemini-2.5-flash

# Optional. Used to read a private GitHub repo, or to raise the public rate limit.
# If empty, the app uses `gh auth token` when the GitHub CLI is already logged in.
# GITHUB_TOKEN=

# Jira Cloud. Issues are created only after you confirm in the page.
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=PROJ
# JIRA_ISSUE_TYPE=Task
